# ==============================================================================
# Pro mTLS Manager - optional configuration
# ==============================================================================
# Every setting below is optional: the value shown is the built-in default.
# Copy this file to `.env`, then uncomment and change only what you need:
#   cp .env.example .env && chmod 600 .env
#
# Docker:     docker-compose.yml loads .env automatically (if it exists).
# Bare metal: the app reads .env from its working directory.
# ==============================================================================

# ---------------------------------------------------------------- Server
# PORT=3000
# Use 127.0.0.1 to only listen locally (e.g. behind a reverse proxy on the same host)
# HOST=0.0.0.0

# ---------------------------------------------------------------- Storage
# Where the root CA, client certs, CRL and settings live.
# Docker ignores this and always uses /app/pki_storage (see docker-compose.yml).
# DATA_DIR=./pki_storage

# ---------------------------------------------------------------- Root CA
# Create the root CA automatically on first start (when DATA_DIR/ca is empty).
# CA_AUTO_INIT=false

# Defaults for auto-init, also pre-filled in the "Initialize Root CA" form
# CA_COMMON_NAME="Pro mTLS Private Root CA"
# CA_ORGANIZATION="Private Infrastructure"
# CA_ORGANIZATIONAL_UNIT="Private Certificate Authority"
# CA_COUNTRY=US
# CA_VALIDITY_DAYS=3650
# CA_KEY_SIZE=2048

# ---------------------------------------------------------------- Client certs
# Comma-separated hostnames pre-filled when issuing a client cert
# (embedded in the cert as OU=host:<hostname>). Empty = you type them each time.
# DEFAULT_ALLOWED_HOSTS=*.example.com

# ---------------------------------------------------------------- CRL
# How many days a generated CRL stays valid
# CRL_VALIDITY_DAYS=30

# ---------------------------------------------------------------- Local Caddy (same machine)
# Only for when Caddy runs on the SAME host as Pro mTLS Manager (bare metal).
# Every time the CRL / CA changes, a copy is written to these paths:
# CRL_OUTPUT_PATH=/etc/caddy/certs/crl.pem
# CA_CERT_OUTPUT_PATH=/etc/caddy/certs/ca.crt
# Run CADDY_RELOAD_CMD locally after every revoke/delete (needs CRL_OUTPUT_PATH)
# CADDY_AUTO_RELOAD_LOCAL=false

# ---------------------------------------------------------------- Remote Caddy (SSH sync)
# Defaults shown in the Server Sync panel
# CADDY_REMOTE_CERTS_DIR=/etc/caddy/certs
# CADDY_RELOAD_CMD="sudo systemctl reload caddy"

# SSH private key used when no key is entered in the UI.
# If unset: ~/.ssh/id_ed25519, then ~/.ssh/id_rsa
# SSH_KEY_PATH=/root/.ssh/id_ed25519

# ---------------------------------------------------------------- Dashboard security
# Salt for hashing the dashboard password. Set a random value BEFORE enabling the
# dashboard password (openssl rand -hex 24). Changing it later invalidates the
# saved password - you'd need to set it again in Settings.
# AUTH_SALT=mtls_salt

# Fail on startup unless the core variables above are set explicitly
# STRICT_ENV_VALIDATION=false
